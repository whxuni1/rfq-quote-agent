# DeepSeek（OpenAI 兼容接口）
PA_LLM_BASE_URL=https://api.deepseek.com
PA_LLM_API_KEY=sk-...
# 按用途映射模型：规划用强模型，路由/记忆抽取用快模型
PA_MODEL_PLANNER=deepseek-v4-pro
PA_MODEL_ROUTER=deepseek-flash
PA_MODEL_MEMORY=deepseek-flash
PA_MODEL_CHAT=deepseek-flash
# 数据目录（SQLite、草稿、报告）
PA_DATA_DIR=~/.personal-agent
# 自托管 SearXNG（web.search 工具）；留空则禁用搜索
PA_SEARXNG_URL=
# 全局出网白名单（逗号分隔）
PA_EGRESS_ALLOWLIST=wikipedia.org,github.com
# Vault 主口令（生产请用交互输入或 OS keyring）
PA_VAULT_PASSPHRASE=
